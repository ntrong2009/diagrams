    <diagram name="CSRF (cổ điển) — Sequence" id="csrf-attack-sequence">
        <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="940" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="CSRF cổ điển — trang lạ khiến trình duyệt gửi request thay mặt nạn nhân" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="1400" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Request đi từ attacker.com sang fb.com ⇒ CROSS-SITE. Đó là điểm mấu chốt: mọi lớp phòng thủ dưới đây đều dựa vào việc nhận ra tính cross-site đó." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1620" height="20" as="geometry"/>
                </mxCell>
