                    <mxGeometry x="60" y="130" width="150" height="710" as="geometry"/>
                </mxCell>
                <mxCell id="brw" value="Browser&#xa;(cookie jar)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;outlineConnect=0;size=44;fillColor=#d0bfff;strokeColor=#9673a6;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="250" y="130" width="190" height="710" as="geometry"/>
                </mxCell>
                <mxCell id="atk" value="attacker.com" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;outlineConnect=0;size=44;fillColor=#ffc9c9;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="130" width="190" height="710" as="geometry"/>
                </mxCell>
                <mxCell id="fb" value="fb.com&#xa;(server hợp lệ)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;outlineConnect=0;size=44;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="750" y="130" width="190" height="710" as="geometry"/>
                </mxCell>
                <mxCell id="fr1" value="Giai đoạn 1 — nạn nhân có phiên đăng nhập hợp lệ" style="shape=umlFrame;whiteSpace=wrap;html=1;width=320;height=28;fillColor=none;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="175" width="910" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="fr2" value="Giai đoạn 2 — nạn nhân mở một trang lạ" style="shape=umlFrame;whiteSpace=wrap;html=1;width=320;height=28;fillColor=none;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="385" width="910" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="fr3" value="Giai đoạn 3 — trình duyệt lặng lẽ gửi request giả mạo" style="shape=umlFrame;whiteSpace=wrap;html=1;width=320;height=28;fillColor=none;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="615" width="910" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="cookie" value="&lt;b&gt;cookie jar&lt;/b&gt;&lt;br&gt;fb.com → session=XYZ789" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="258" y="318" width="175" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="exec" value="&lt;b&gt;⑦ form.submit()&lt;/b&gt;&lt;br&gt;Chạy ngay khi trang load. Nạn nhân không bấm gì cả." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="258" y="520" width="175" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="srv" value="&lt;b&gt;Server thấy gì&lt;/b&gt;&lt;br&gt;Cookie hợp lệ ✓ · không có CSRF token ✗&lt;br&gt;⇒ tin request là do chính nạn nhân gửi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="758" y="690" width="175" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="m1" value="① đăng nhập fb.com" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="135" y="215" as="sourcePoint"/>
                        <mxPoint x="345" y="215" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m2" value="② POST /login (credentials)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="345" y="255" as="sourcePoint"/>
                        <mxPoint x="845" y="255" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m3" value="③ 200 OK + Set-Cookie: session=XYZ789" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="845" y="300" as="sourcePoint"/>
                        <mxPoint x="345" y="300" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m4" value="④ mở attacker.com/free-iphone" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="135" y="425" as="sourcePoint"/>
                        <mxPoint x="345" y="425" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m5" value="⑤ GET /free-iphone" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="345" y="465" as="sourcePoint"/>
                        <mxPoint x="595" y="465" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m6" value="⑥ HTML có form ẩn, action trỏ về fb.com" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="595" y="505" as="sourcePoint"/>
                        <mxPoint x="345" y="505" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m7" value="⑧ POST /change-password (new_pw=hacked)  ← CROSS-SITE" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="345" y="660" as="sourcePoint"/>
                        <mxPoint x="845" y="660" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m8" value="⑨ 200 OK — mật khẩu đã đổi" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="845" y="795" as="sourcePoint"/>
                        <mxPoint x="345" y="795" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="n1" value="&lt;b&gt;Cắt ở ⑧ — SameSite  ★ lớp mạnh nhất hiện nay&lt;/b&gt;&lt;br&gt;Từ Chrome 80 (2020), cookie không khai SameSite được coi là Lax ⇒ KHÔNG gửi kèm POST cross-site. Nghĩa là cuộc tấn công vẽ ở đây THẤT BẠI mặc định trên trình duyệt hiện đại.&lt;br&gt;⚠ Vẫn sống nếu cookie đặt SameSite=None; Secure — cấu hình bắt buộc cho SSO cross-domain và iframe nhúng." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="990" y="175" width="660" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;Cắt ở ⑧ — kiểm Origin / Sec-Fetch-Site&lt;/b&gt;&lt;br&gt;Từ chối thao tác đổi trạng thái khi Sec-Fetch-Site: cross-site, hoặc khi Origin không nằm trong allowlist. Rẻ, không cần lưu state, không phụ thuộc form." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="990" y="355" width="660" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="n3" value="&lt;b&gt;Cắt ở ⑧ — antiforgery token&lt;/b&gt;&lt;br&gt;Token nằm trong form hoặc header, gắn với phiên. attacker.com không đọc được vì same-origin policy chặn. Vẫn cần khi không dựa được vào SameSite (ví dụ cookie buộc phải SameSite=None)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="990" y="495" width="660" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="n4" value="&lt;b&gt;⚠ Bẫy: endpoint đổi trạng thái nhận GET&lt;/b&gt;&lt;br&gt;SameSite=Lax VẪN cho cookie đi kèm điều hướng GET ở cấp cao nhất. Nếu /change-password chấp nhận GET thì chỉ một thẻ &lt;img src&gt; hoặc một cái link cũng kích hoạt được. Thao tác đổi trạng thái phải là POST/PUT/DELETE." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="990" y="645" width="660" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="n5" value="&lt;b&gt;Ở ⑥ không chặn được gì&lt;/b&gt;&lt;br&gt;attacker.com có toàn quyền trả về HTML bất kỳ. Đừng tìm cách phòng thủ ở chặng này." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="990" y="800" width="660" height="90" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
