                <mxCell id="fr2" value="Giai đoạn 2 — nạn nhân mở trang, có thể nhiều ngày sau" style="shape=umlFrame;whiteSpace=wrap;html=1;width=300;height=28;fillColor=none;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="430" width="1420" height="255" as="geometry"/>
                </mxCell>
