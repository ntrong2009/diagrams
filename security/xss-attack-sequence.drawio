                <mxCell id="m3" value="③ INSERT — lưu NGUYÊN VĂN, không sanitize" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
