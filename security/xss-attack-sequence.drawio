                <mxCell id="fr1" value="Giai đoạn 1 — kẻ tấn công gieo payload qua một form bình thường" style="shape=umlFrame;whiteSpace=wrap;html=1;width=300;height=28;fillColor=none;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
