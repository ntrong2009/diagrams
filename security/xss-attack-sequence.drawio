                </mxCell>
                <mxCell id="m1" value="① nhập payload vào ô input: &lt;script&gt;…&lt;/script&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="135" y="240" as="sourcePoint"/>
