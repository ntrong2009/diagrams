                <mxCell id="m5" value="200 OK — payload đã nằm trong DB" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=11;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="790" y="400" as="sourcePoint"/>
