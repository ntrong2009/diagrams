                <mxCell id="sub" value="Một request duy nhất từ https://app.gridsz.com tới https://api.gridsz.com. Lane = nơi việc kiểm tra thật sự xảy ra." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="54" width="1600" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_br" value="Trình duyệt&#xa;(JS · app.gridsz.com)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontColor=#3a5a86;verticalAlign=middle;align=center;" parent="1" vertex="1">
