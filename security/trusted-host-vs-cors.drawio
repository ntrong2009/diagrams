                </mxCell>
                <mxCell id="hdr_api" value="API pipeline&#xa;(middleware)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#7f6000;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="170" height="190" as="geometry"/>
                </mxCell>
