                </mxCell>
                <mxCell id="hdr_ws" value="Web server /&#xa;reverse proxy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#4f7a34;verticalAlign=middle;align=center;" parent="1" vertex="1">
