                    <mxGeometry x="210" y="610" width="1850" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_app" value="Application&#xa;(API controller)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6a4a8a;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="800" width="170" height="150" as="geometry"/>
                </mxCell>
