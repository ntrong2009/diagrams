                    <mxGeometry x="210" y="800" width="1850" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="n1" value="&lt;b&gt;① JS gọi fetch()&lt;/b&gt;&lt;br&gt;fetch(&#39;https://api.gridsz.com/api/data&#39;)&lt;br&gt;Origin: https://app.gridsz.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="240" y="175" width="230" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="② Request đơn giản ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="510" y="168" width="210" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="n_pre" value="&lt;b&gt;② Preflight OPTIONS&lt;/b&gt;&lt;br&gt;Chỉ với request KHÔNG đơn giản.&lt;br&gt;Preflight fail ⇒ DỪNG HẲN — request thật không bao giờ được gửi." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="500" y="300" width="230" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="note_gates" value="&lt;b&gt;Hai cổng, hai thời điểm&lt;/b&gt;&lt;br&gt;CỔNG A (Trusted Host) chặn cả request, TRƯỚC khi nó vào Application.&lt;br&gt;CỔNG B (CORS) không chặn request — nó chỉ chặn JS ĐỌC response, SAU KHI Application đã chạy xong." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="910" y="290" width="610" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="⑦ CỔNG B — CORS&#xa;Response có Access-Control-Allow-Origin khớp Origin ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1504" y="161" width="210" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="n_ok" value="&lt;b&gt;JS đọc được data ✓&lt;/b&gt;&lt;br&gt;Response tới tay mã JS của app.gridsz.com." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="175" width="230" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="n_blocked" value="&lt;b&gt;JS bị chặn — lỗi CORS ✗&lt;/b&gt;&lt;br&gt;Nhưng bước ⑤ ĐÃ CHẠY xong: DB đã đổi, mail đã gửi. Trình duyệt chỉ giấu response khỏi JS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1800" y="300" width="230" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="gA" value="③ CỔNG A — Trusted Host&#xa;Host có trong danh sách ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="770" y="455" width="210" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="n400" value="&lt;b&gt;400 Bad Request ✗&lt;/b&gt;&lt;br&gt;Đóng kết nối. Request KHÔNG bao giờ tới Application." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="470" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="note_host" value="&lt;b&gt;Vì sao evil-site.com qua được CỔNG A ?&lt;/b&gt;&lt;br&gt;Vì Host: api.gridsz.com vẫn ĐÚNG. Host nói request gửi TỚI đâu — Origin mới nói request gửi TỪ đâu. Trusted Host không nhìn Origin, nên nó không có lý do gì để chặn." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="470" width="520" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="gC" value="④ CORS middleware&#xa;Origin có trong danh sách ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1290" y="625" width="210" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="n_hdr_yes" value="&lt;b&gt;YES → gắn header&lt;/b&gt;&lt;br&gt;Access-Control-Allow-Origin: https://app.gridsz.com" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="628" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n_hdr_no" value="&lt;b&gt;NO → không gắn header&lt;/b&gt;&lt;br&gt;vd Origin = https://evil-site.com. Request VẪN đi tiếp." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="708" width="230" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="n_app" value="&lt;b&gt;⑤ Application xử lý request&lt;/b&gt;&lt;br&gt;Đọc/ghi DB, gửi mail, trừ tiền — side effect XẢY RA THẬT ở đây, bất kể Origin là ai." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="825" width="490" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="note_csrf" value="&lt;b&gt;CORS KHÔNG bảo vệ thao tác đổi trạng thái&lt;/b&gt;&lt;br&gt;Vì request vẫn được xử lý, một POST /api/transfer từ evil-site.com vẫn thực thi bình thường — kẻ tấn công chỉ không đọc được response. Chặn việc đó là của CSRF token và SameSite cookie, không phải CORS." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="240" y="820" width="1000" height="110" as="geometry"/>
                </mxCell>
