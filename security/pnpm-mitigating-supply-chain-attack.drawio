<mxfile host="65bd71144e">
    <diagram name="pnpm — chặn supply chain attack theo từng chặng" id="pnpm-supply-chain">
        <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Supply chain attack qua npm — pnpm chặn được ở chặng nào" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="1500" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Lane = THỜI ĐIỂM trong vòng đời pnpm install. Bốn lớp phòng thủ không cùng loại: chúng chặn ở ba thời điểm khác nhau. Mỗi cổng là một cơ hội làm đứt chuỗi." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1800" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="sub2" value="(*) Tên setting và giá trị mặc định cần đối chiếu tài liệu pnpm 11 — chưa xác minh được. allowBuilds và overrides thì đã xác nhận là có thật." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="1800" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_pub" value="Trước khi publish&#xa;(ngoài phạm vi pnpm)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;fontColor=#555555;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="170" width="190" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="lane_pub" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="230" y="170" width="1620" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_reg" value="npm registry" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;fontColor=#555555;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="320" width="190" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lane_reg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="230" y="320" width="1620" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_res" value="pnpm — lúc RESOLVE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#4f7a34;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="460" width="190" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="lane_res" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="230" y="460" width="1620" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_lock" value="pnpm — lúc ĐỌC LOCKFILE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#4f7a34;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="660" width="190" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="lane_lock" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="230" y="660" width="1620" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_inst" value="pnpm — lúc CÀI ĐẶT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#4f7a34;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="920" width="190" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="lane_inst" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;" parent="1" vertex="1">
                    <mxGeometry x="230" y="920" width="1620" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="&lt;b&gt;① Chiếm quyền publish&lt;/b&gt;&lt;br&gt;Phishing, token CI bị lộ, tài khoản maintainer bị chiếm." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="200" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="d0" value="&lt;b&gt;pnpm không can thiệp được ở đây&lt;/b&gt;&lt;br&gt;2FA bắt buộc · token ngắn hạn, scope hẹp · trusted publisher / OIDC thay cho token dài hạn. Đây là việc của chủ package và của registry, không phải của package manager." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="870" y="195" width="470" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="&lt;b&gt;② Publish version độc&lt;/b&gt;&lt;br&gt;Đẩy lên npm registry dưới tên package hợp lệ, số version mới." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="350" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="n2" value="&lt;b&gt;Version độc đã có mặt công khai&lt;/b&gt;&lt;br&gt;Từ giây này, bất kỳ ai chạy install mà không ghim version đều có thể kéo về." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="870" y="350" width="470" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="&lt;b&gt;③ Pipeline kéo bản mới&lt;/b&gt;&lt;br&gt;install tự động trên CI hoặc máy dev." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="490" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="g1" value="Version có đủ &quot;chín&quot;&#xa;và đã được ghim chưa ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="615" y="485" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="def1" value="&lt;b&gt;minimumReleaseAge (*)&lt;/b&gt;&lt;br&gt;Hoãn resolve các version vừa publish ⇒ cộng đồng có thời gian phát hiện và gỡ bản độc trước khi bạn kéo về.&lt;br&gt;&lt;br&gt;overrides — ép nâng dependency transitive dính CVE lên bản đã vá." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="870" y="478" width="470" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="stop1" value="&lt;b&gt;Chuỗi đứt ở đây&lt;/b&gt;&lt;br&gt;Version độc không được chọn để cài." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="495" width="440" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="&lt;b&gt;③b Lockfile bị sửa hoặc dep transitive trỏ nguồn lạ&lt;/b&gt;&lt;br&gt;Thay hash trong lockfile, hoặc một dep sâu trong cây trỏ sang git / tarball / file URL." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="695" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="g2" value="Lockfile khớp và&#xa;nguồn hợp lệ ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="615" y="700" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="def2" value="&lt;b&gt;Lockfile verification · blockExoticSubdeps (*) · trustPolicyQuery (*)&lt;/b&gt;&lt;br&gt;Cài đúng thứ đã ghi trong lockfile · chặn dep transitive dùng nguồn &quot;exotic&quot; (git, tarball, file URL) · tra attestation API của registry (SLSA provenance, Sigstore, trusted publisher) để gán mức tin cậy cho từng version." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="870" y="685" width="470" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="warn" value="&lt;b&gt;⚠ trustLockfile = true (*) vô hiệu hoá cổng này&lt;/b&gt;&lt;br&gt;Bỏ qua kiểm lockfile ⇒ cả lớp phòng thủ này mất tác dụng. Đây là công tắc nguy hiểm nhất trên hình." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="870" y="845" width="470" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="stop2" value="&lt;b&gt;Chuỗi đứt ở đây&lt;/b&gt;&lt;br&gt;Lockfile không khớp hoặc nguồn bị từ chối ⇒ install dừng." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="700" width="440" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a5" value="&lt;b&gt;④ Chạy mã độc lúc cài&lt;/b&gt;&lt;br&gt;Qua postinstall / lifecycle script của package." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="950" width="300" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="g3" value="Package có được liệt kê&#xa;trong allowBuilds ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="615" y="945" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="def3" value="&lt;b&gt;allowBuilds&lt;/b&gt;&lt;br&gt;Lifecycle script bị CHẶN mặc định. Chỉ package bạn liệt kê rõ mới được chạy build — dạng map opt-in từng package." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="870" y="945" width="470" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="stop3" value="&lt;b&gt;Chuỗi đứt ở đây&lt;/b&gt;&lt;br&gt;Script không chạy. Mã độc nằm im trong node_modules, không thực thi." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontStyle=0;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="950" width="440" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="out" value="&lt;b&gt;Nếu vượt qua cả ba cổng: mã độc chạy với quyền của người cài&lt;/b&gt;&lt;br&gt;Đọc được biến môi trường, token CI, SSH key, nội dung repo — và có mạng. Đây là lý do vì sao cả ba cổng đều nên bật, chứ không chọn một." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="1150" width="1080" height="100" as="geometry"/>
                </mxCell>
