<mxfile host="65bd71144e">
    <diagram name="Angular cache layers — API vs static" id="angular-api-cache-layers">
        <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Angular cache layers — hai luồng song song: API payload vs static files" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Lane = nơi cache thật sự nằm. Trái → phải = miss, đi sâu thêm một tầng. Hai luồng rơi vào các lane rời nhau — đó chính là lý do chúng không dùng chung tầng cache nào ngoài source of truth." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="54" width="1780" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="lane_browser" value="Browser" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=none;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;fontColor=#3a5a86;" parent="1" vertex="1">
                    <mxGeometry x="40" y="150" width="1760" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lane_app" value="Angular app (in-app)" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=none;strokeColor=#9673a6;fontStyle=1;fontSize=12;fontColor=#6a4a8a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="290" width="1760" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lane_edge" value="Edge / CDN" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=none;strokeColor=#82b366;fontStyle=1;fontSize=12;fontColor=#4f7a34;" parent="1" vertex="1">
                    <mxGeometry x="40" y="430" width="1760" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lane_server" value="Server" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=none;strokeColor=#d6b656;fontStyle=1;fontSize=12;fontColor=#7f6000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="570" width="1760" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="lane_src" value="Source of truth" style="swimlane;html=1;startSize=30;horizontal=0;fillColor=none;strokeColor=#b85450;fontStyle=1;fontSize=12;fontColor=#8a3b38;" parent="1" vertex="1">
                    <mxGeometry x="40" y="710" width="1760" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="b0" value="B0 · LUỒNG B — static files (JS bundles, CSS, fonts, images)&#xa;browser yêu cầu: GET /main.[hash].js&#xa;trả về JS / CSS / image" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="90" y="168" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="B1 · Service Worker&#xa;PWA precache · App Shell · @angular/service-worker&#xa;Cache API · cache-first — ~0–2 ms (từ disk)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="430" y="168" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="B2 · Browser HTTP cache&#xa;Cache-Control + ETag · immutable hash = cache 1 năm&#xa;disk / memory, do browser quản — ~1–5 ms · in-process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="770" y="168" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="B3 · CDN edge cache&#xa;Cloudflare / GCP CDN · edge POPs · TLS terminate&#xa;Brotli compression — ~20–50 ms (edge gần user)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="448" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="B4 · Origin storage (source of truth)&#xa;GCS / S3 bucket · web server · built artifacts từ CI/CD&#xa;~100–300 ms — chỉ chạm khi cache miss" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="835" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a0" value="A0 · LUỒNG A — API payload (dynamic JSON từ REST/GraphQL)&#xa;component gọi: http.get('/api/users')&#xa;trả về JSON payload" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="90" y="308" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="A1 · HTTP Interceptor&#xa;in-app memory cache · Map + shareReplay(1)&#xa;~0 ms · in-memory" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="430" y="308" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="A2 · BFF + Request Dedup&#xa;gateway / aggregation · gộp call · single-flight&#xa;in-process LRU — ~10 ms · gateway layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="770" y="588" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="A3 · Redis / API cache&#xa;distributed memcache · Redis · Memcached&#xa;TTL · tag-based invalidate — ~5–10 ms · cluster cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="588" width="300" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="A4 · Database / backend (source of truth)&#xa;PostgreSQL · API gốc · disk I/O · JOIN · index lookup&#xa;~50–500 ms — đắt nhất, cố tránh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="728" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="e_b0_b1" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;" parent="1" source="b0" target="b1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_b1_b2" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;" parent="1" source="b1" target="b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_b2_b3" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;" parent="1" source="b2" target="b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_b3_b4" value="miss → origin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" parent="1" source="b3" target="b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_a0_a1" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;" parent="1" source="a0" target="a1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_a1_a2" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;" parent="1" source="a1" target="a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_a2_a3" value="miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#333333;" parent="1" source="a2" target="a3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_a3_a4" value="miss → DB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;" parent="1" source="a3" target="a4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="Cách đọc&#xa;• Mũi tên liền = MISS, đi sâu thêm một tầng. Tầng càng phải càng đắt.&#xa;• Bất kỳ tầng nào HIT ⇒ trả dữ liệu về ngay, KHÔNG đi tiếp các tầng bên phải.&#xa;• Lane cho biết cache nằm ở đâu — nên không cần ghi &quot;chủ thể&quot; trong từng hộp nữa." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="970" width="870" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="noteA" value="Luồng A: SW + CDN có thể chèn vào trước HTTP Interceptor nếu API public (catalog, blog) và có Cache-Control phù hợp. Với private/auth API thì thường bypass.&#xa;Luồng B: static files KHÔNG bao giờ chạm HTTP Interceptor (nó chỉ chặn HttpClient) hay Redis/Database (đó là tầng dữ liệu, không phải tầng file)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="930" y="970" width="870" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="stitle" value="Nguyên tắc chung — cache key, invalidation, consistency, monitor" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1080" width="1000" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="Cache key design&#xa;• API: URL + query params + Vary header (Authorization, locale)&#xa;• Static: URL + content hash (outputHashing=all)&#xa;• Normalize URL trước khi hash&#xa;• Tránh collision (multi-tenant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1115" width="430" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="Cache invalidation&#xa;• API: event-driven (backend publish → invalidate Redis + edge)&#xa;• Static: content hash đổi ⇒ URL đổi ⇒ cache tự bust&#xa;• TTL hợp lý cho API (5 phút list, 1 giờ config)&#xa;• Tag-based invalidate cho nhóm related" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="490" y="1115" width="430" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="Consistency vs speed&#xa;• API: Strong (banking, inventory) vs Eventual (catalog, profile)&#xa;• Static: immutable 1 năm — không cần consistency&#xa;• Stale-while-revalidate: trả cache cũ ngay, fetch ngầm&#xa;• Cache stampede: dùng single-flight tránh thundering herd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="940" y="1115" width="430" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="Monitor &amp; tune&#xa;• Hit rate mỗi tầng (target: in-app &gt; 30%, edge/HTTP &gt; 70%)&#xa;• Static: theo dõi CDN hit rate &gt; 95%&#xa;• API: theo dõi Redis hit + DB QPS&#xa;• Alert khi hit rate giảm đột ngột (key lỗi?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="1115" width="410" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
