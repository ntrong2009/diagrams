                <mxCell id="l_disk_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="640" width="960" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="pg1" value="&lt;b&gt;SELECT * FROM ...&lt;/b&gt;&lt;br&gt;Npgsql trả về TOÀN BỘ result set trong một lần, app phải nhận hết mới đi tiếp." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="235" width="920" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="pg2" value="&lt;b&gt;COPY (query) TO STDOUT (FORMAT CSV, DELIMITER ';', NULL '', QUOTE '&quot;', ESCAPE '&quot;')&lt;/b&gt;&lt;br&gt;Postgres tự sinh CSV và đẩy ra liên tục theo khối, không chờ gom đủ." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="235" width="920" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ram1" value="&lt;b&gt;Toàn bộ dữ liệu nằm trong heap — RAM = O(n)&lt;/b&gt;&lt;br&gt;List&amp;lt;T&amp;gt; reportData — toàn bộ object đọc từ DB&lt;br&gt;List&amp;lt;string&amp;gt; lines — toàn bộ dòng ĐÃ format&lt;br&gt;⇒ hai bản dữ liệu tồn tại cùng lúc, cộng mảng lines.ToArray()&lt;br&gt;&lt;br&gt;1 triệu dòng × 1 KB ≈ 2 GB heap. Data lớn hơn heap ⇒ OutOfMemoryException.&lt;br&gt;Kích thước khối này lớn lên đúng bằng tốc độ dữ liệu lớn lên." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="380" width="920" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="buf" value="&lt;b&gt;char[4096] — 4 KB&lt;/b&gt;&lt;br&gt;Một buffer duy nhất, tái sử dụng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="430" width="280" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="cap2" value="RAM = O(1). Buffer không lớn lên theo số dòng — 10 nghìn dòng hay 100 triệu dòng đều dùng đúng 4 KB này.&#xa;Khoảng trống còn lại của lane chính là phần RAM bạn không phải trả." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#4f7a34;" parent="1" vertex="1">
                    <mxGeometry x="1580" y="435" width="600" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="disk1" value="&lt;b&gt;File.WriteAllLines(path, lines.ToArray())&lt;/b&gt;&lt;br&gt;Ghi MỘT lần, sau khi đã load và format xong tất cả.&lt;br&gt;Byte đầu tiên của file chỉ xuất hiện ở cuối quá trình." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="260" y="665" width="920" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="disk2" value="&lt;b&gt;StreamWriter ghi nối tiếp từng khối&lt;/b&gt;&lt;br&gt;File có byte đầu tiên ngay sau khối đầu tiên.&lt;br&gt;Ghi tới đâu giải phóng buffer tới đó." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="665" width="920" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="① nạp hết" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="pg1" target="ram1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="② ghi một lần" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="ram1" target="disk1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="① đọc 4 KB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="pg2" target="buf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="② ghi ngay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="buf" target="disk2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="③ lặp tới khi hết dữ liệu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#4f7a34;fontColor=#4f7a34;fontStyle=1;" parent="1" source="disk2" target="buf" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="code1" value="// BaseExporter.SaveToCsv&lt;T&gt;&#xa;var lines = new List&lt;string&gt;();&#xa;lines.Add(header);&#xa;var valueLines = reportData&#xa;    .Select(row =&gt; string.Join(&quot;;&quot;, ...))&#xa;    .ToList();                          // toàn bộ dòng đã format&#xa;lines.AddRange(valueLines);&#xa;File.WriteAllLines(path, lines.ToArray(), Encoding.UTF8);" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=10;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="240" y="820" width="960" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="code2" value="// BaseExporter.ExportAsPostgresCommand   (bufferSize = 4 * 1024)&#xa;await using var streamWriter = new StreamWriter(path, false, Encoding.UTF8, bufferSize);&#xa;await streamWriter.WriteLineAsync(string.Join(delimiter, selectedColumns));&#xa;using var copyOut = await connection.BeginTextExportAsync(copyCommand);&#xa;var buffer = new char[bufferSize];&#xa;while ((read = await copyOut.ReadAsync(buffer)) &gt; 0)&#xa;    await streamWriter.WriteAsync(buffer.AsMemory(0, read));" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=10;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="820" width="960" height="180" as="geometry"/>
                </mxCell>
