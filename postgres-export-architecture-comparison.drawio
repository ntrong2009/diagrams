    <diagram name="Postgres export — Traditional vs Streaming" id="postgres-export-comparison">
        <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1460" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
