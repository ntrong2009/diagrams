                <mxCell id="title" value="Postgres export — Traditional vs Streaming: khác nhau ở đúng một lane" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1600" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Hai cách cùng đi qua ba nơi giống hệt nhau. Toàn bộ khác biệt nằm ở lane giữa — RAM của App Server. Code trích từ Mose.Api.Task/Services/Exporter/BaseExporter.cs." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="54" width="1900" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="band1" value="CÁCH 1 — Traditional: load hết rồi mới ghi" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fontColor=#8a3b38;" parent="1" vertex="1">
                    <mxGeometry x="240" y="150" width="960" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="band2" value="CÁCH 2 — Streaming: COPY TO STDOUT, ghi cuốn chiếu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;align=left;spacingLeft=12;fontColor=#4f7a34;" parent="1" vertex="1">
                    <mxGeometry x="1240" y="150" width="960" height="40" as="geometry"/>
                </mxCell>
