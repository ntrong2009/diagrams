    <diagram id="4d-framework" name="4D Framework">
        <mxGraphModel dx="1200" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="700" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="fd_title" value="4D Framework for AI Fluency" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1f2937;" parent="1" vertex="1">
                    <mxGeometry x="40" y="125" width="900" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="fd_sub" value="A framework about &lt;b&gt;user skills&lt;/b&gt; — not a Claude Code mechanism" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" parent="1" vertex="1">
                    <mxGeometry x="40" y="161" width="900" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="fd_lblfb" value="Typical working sequence — evaluation results lead to the next delegation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;align=center;fontSize=11;fontColor=#868e96;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="177" width="640" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d1" value="&lt;b&gt;D1 · Delegation&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Decide whether / when / how to delegate to AI&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;In the architecture:&lt;/b&gt; choose surface (CLI · IDE · web — also decides whether Tier 2 runs on your machine or an Anthropic VM) ·&lt;br&gt;choose model · edit yourself or let the agent · whether to split Subagents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#d0ebff;strokeColor=#1971c2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="225" width="760" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d2" value="&lt;b&gt;D2 · Description&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Express the goal so the AI does it right&lt;/i&gt;&lt;br&gt;&lt;b&gt;Prompting lives here&lt;/b&gt; — and is only part of this D&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;In the architecture:&lt;/b&gt; Your prompt (transient) ·&lt;br&gt;CLAUDE.md · rules/ · skills/ · commands/ = Description made durable: write once, reuse many times&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#d3f9d8;strokeColor=#2f9e44;" parent="1" vertex="1">
                    <mxGeometry x="840" y="225" width="760" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d3" value="&lt;b&gt;D3 · Discernment&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Evaluate quality, correctness, bias of the output&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;In the architecture:&lt;/b&gt; the Verify results step in the Agentic Loop · read the diff before accepting ·&lt;br&gt;run tests / lint · don&#39;t trust the agent&#39;s report without checking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#fff3bf;strokeColor=#e8a33d;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="225" width="760" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d4" value="&lt;b&gt;D4 · Diligence&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 11px;&quot;&gt;— applies to all three steps above, not a separate step&lt;/font&gt;&lt;br&gt;&lt;i&gt;Take responsibility for using AI and how — including governance, ethics, safety&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Mechanized in the architecture:&lt;/b&gt;&amp;nbsp; Permission gate (allow / ask / deny) · Hooks · settings.json committed for the team · Enterprise managed policy ★&lt;br&gt;&lt;b&gt;Cannot be mechanized:&lt;/b&gt;&amp;nbsp; transparency about what the AI wrote · accountability at merge · knowing when to stop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="465" width="2360" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="fd_note" value="&lt;b&gt;About the 4D framework&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;— Authors: Prof Rick Dakan (Ringling College of Art and Design) &amp;amp; Prof Joseph Feller (University College Cork); used in Anthropic&#39;s AI Fluency course.&lt;br&gt;— Source: aifluencyframework.org · anthropic.skilljar.com/ai-fluency-framework-foundations&lt;br&gt;&lt;br&gt;— The original framework describes the four D&#39;s as &lt;b&gt;four interdependent competencies&lt;/b&gt;, with no mandatory order. The sequence arrows and loop here are an interpretation for drawing, not a statement of the framework.&lt;br&gt;&lt;br&gt;— Each box&#39;s color matches the corresponding component in the architecture page: D4 purple = Permission gate / settings.json, D2 green = CLAUDE.md.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8f9fa;strokeColor=#adb5bd;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#495057;" parent="1" vertex="1">
                    <mxGeometry x="40" y="655" width="2360" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="fd_f1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#495057;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="fd_d1" target="fd_d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="fd_f2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#495057;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="fd_d2" target="fd_d3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="fd_fb" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;html=1;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=block;endFill=1;strokeColor=#868e96;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="fd_d3" target="fd_d1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="2020" y="203"/>
                            <mxPoint x="420" y="203"/>
                        </Array>
