                <mxCell id="loc" value="location /api/ {&#xa;    proxy_pass http://backend:3000;&#xa;    proxy_set_header Host  ← 4 lựa chọn ở bảng dưới&#xa;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontFamily=Courier New;" parent="1" vertex="1">
