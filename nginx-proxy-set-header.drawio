                <mxCell id="r0d" value="Mặc định nên dùng. Giữ đúng tên miền khách gõ, nên app dựng redirect và link tuyệt đối vẫn đúng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="720" width="600" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r0e" value="configmap-nginx-portal-env.yaml — 3 chỗ (dòng 76, 87, 119)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="720" width="770" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r1a" value="$http_host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="40" y="816" width="200" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r1b" value="app.com:8443&#xa;(nguyên văn, CÓ port)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="250" y="816" width="290" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r1c" value="✗ lệch vì có :8443" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="550" y="816" width="220" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r1d" value="Khi upstream thật sự cần biết cả port. Phải nhớ thêm cả dạng có port vào danh sách trusted host." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="816" width="600" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r1e" value="không dùng ở đâu cả" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="816" width="770" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r2a" value="$proxy_host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="40" y="912" width="200" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r2b" value="backend:3000&#xa;(tên trong proxy_pass)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="250" y="912" width="290" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r2c" value="✗ lệch hoàn toàn" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="550" y="912" width="220" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r2d" value="Gần như không bao giờ chủ ý dùng — NHƯNG đây là MẶC ĐỊNH của nginx khi bạn không viết dòng nào." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="912" width="600" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r2e" value="configmap-nginx-admingui-env.yaml — location /uaaserver/ và /admingui/ đang rơi vào ca này mà không cố ý (xem bẫy ②)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="912" width="770" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r3a" value="Hard-code&#xa;vd: api.internal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1008" width="200" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r3b" value="api.internal&#xa;(đúng chuỗi bạn gõ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="250" y="1008" width="290" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r3c" value="✓ nếu nằm trong danh sách" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="550" y="1008" width="220" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r3d" value="Khi proxy sang một host NGOÀI đòi đúng tên của nó. Đánh đổi: mất tên miền gốc của khách." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="780" y="1008" width="600" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="r3e" value="configmap-nginx-portal-env.yaml:128 — proxy_pass sang management.build-uat.gridsz.com, bắt buộc hard-code, kèm proxy_ssl_server_name on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1390" y="1008" width="770" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="trap_t" value="Hai cái bẫy" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1130" width="600" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="trap1" value="&lt;b&gt;① Mặc định KHÔNG phải $host mà là $proxy_host&lt;/b&gt;&lt;br&gt;Không viết proxy_set_header Host dòng nào thì nginx tự gửi Host: &lt;tên trong proxy_pass&gt;. Upstream nào kiểm trusted host hoặc tự dựng URL tuyệt đối sẽ hỏng ngay — và hỏng theo kiểu &quot;chạy ngon ở local, 400 trên prod&quot;." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1160" width="700" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="trap2" value="&lt;b&gt;② Viết một proxy_set_header là XOÁ SẠCH các dòng kế thừa&lt;/b&gt;&lt;br&gt;nginx chỉ kế thừa proxy_set_header từ cấp trên KHI cấp hiện tại không có dòng proxy_set_header nào. Thêm một dòng X-Request-ID trong location là mất luôn Host, X-Forwarded-For… đã đặt ở server/http. Đây chính là chuyện đang xảy ra ở /uaaserver/ và /admingui/." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1160" width="700" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="trap3" value="&lt;b&gt;Đừng quên bộ header đi kèm&lt;/b&gt;&lt;br&gt;X-Forwarded-For · X-Forwarded-Proto · X-Forwarded-Host. Thiếu chúng thì app không dựng lại được URL gốc: redirect sẽ trỏ về http://backend:3000, và log ghi IP của nginx thay vì của khách. Config portal của bạn đã có X-Real-IP, X-Forwarded-For, X-Forwarded-Proto." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1480" y="1160" width="680" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
