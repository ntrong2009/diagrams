                <mxCell id="req" value="&lt;b&gt;GET /api/data&lt;/b&gt;&lt;br&gt;Host: app.com:8443" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
