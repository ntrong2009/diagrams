                <mxCell id="tbl_t" value="Bốn lựa chọn — cùng request Host: app.com:8443, proxy_pass http://backend:3000" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
