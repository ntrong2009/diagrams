                <mxCell id="local_0" value="&lt;b&gt;Angular 21.2 · TypeScript 5.9&lt;/b&gt;&lt;br&gt;nền tảng framework + ngôn ngữ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
