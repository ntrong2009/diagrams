                </mxCell>
                <mxCell id="pre_1" value="&lt;b&gt;commitlint&lt;/b&gt;&lt;br&gt;ép commit message theo quy ước đã ghi trong CLAUDE.md" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
