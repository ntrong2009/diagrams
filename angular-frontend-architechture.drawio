                <mxCell id="ci_0" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;19 workflow: ci-*, pr-*, hf-* cho 5 app + e2e, sonar, storybook" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
