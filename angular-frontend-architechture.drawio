                </mxCell>
                <mxCell id="ci_4" value="&lt;b&gt;Jest 30&lt;/b&gt;&lt;br&gt;unit test · jest-preset-angular · coverage ≥ 50% trên code mới" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="474" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="ci_5" value="&lt;b&gt;Storybook test-runner&lt;/b&gt;&lt;br&gt;chạy story như test, nền Playwright" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
