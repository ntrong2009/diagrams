                <mxCell id="ci_9" value="&lt;b&gt;jira-title&lt;/b&gt;&lt;br&gt;kiểm tiêu đề PR có mã Jira" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="564" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="ci_10" value="&lt;b&gt;Dependabot / Renovate&lt;/b&gt;&lt;br&gt;tự nâng phụ thuộc và vá bảo mật" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="238" y="654" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="ci_11" value="&lt;b&gt;pnpm audit / Snyk&lt;/b&gt;&lt;br&gt;quét lỗ hổng trong cây phụ thuộc" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="546" y="654" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="ci_12" value="&lt;b&gt;libs/ không được test trong CI&lt;/b&gt;&lt;br&gt;Không workflow nào chạy nx test cho lib; coverage chỉ đo ở 5 app. Test viết trong libs/ không bao giờ chạy và không tính vào con số nào." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="854" y="654" width="598" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="ci_13" value="&lt;b&gt;Ràng buộc tầng không chặn gì&lt;/b&gt;&lt;br&gt;eslint-plugin-boundaries đã cài nhưng chưa cấu hình ở đâu. @nx/enforce-module-boundaries vẫn dùng tag mẫu của Nx (scope:orders, scope:products) trong khi mọi project.json đều tags: []." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="744" width="598" height="72" as="geometry"/>
