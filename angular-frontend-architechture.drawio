                <mxCell id="pre_0" value="&lt;b&gt;husky + lint-staged&lt;/b&gt;&lt;br&gt;chạy Prettier + ESLint + Stylelint trên đúng file vừa sửa, trước khi commit" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
