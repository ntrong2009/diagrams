                <mxCell id="ci_3" value="&lt;b&gt;Stylelint 16&lt;/b&gt;&lt;br&gt;lint:style:* · scss, order, prettier — chạy như bước RIÊNG, nx lint không bao gồm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
