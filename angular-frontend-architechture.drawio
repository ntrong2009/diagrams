                <mxCell id="ci_2" value="&lt;b&gt;ESLint 9&lt;/b&gt;&lt;br&gt;nx lint · @angular-eslint, @typescript-eslint, boundaries, storybook, cypress" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
