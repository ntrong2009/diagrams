                </mxCell>
                <mxCell id="pre_2" value="&lt;b&gt;Lane này đang TRỐNG&lt;/b&gt;&lt;br&gt;Không có .husky, không lint-staged, không cả script prepare. Mọi lỗi format/lint chỉ bị bắt sau khi đã push lên CI — vòng phản hồi dài hơn nhiều so với chặn ngay lúc commit." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="854" y="366" width="906" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_ci" value="PR / CI  (GitHub Actions)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;fontColor=#4f7a34;verticalAlign=middle;align=center;" parent="1" vertex="1">
