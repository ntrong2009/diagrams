<mxfile host="65bd71144e">
    <diagram name="Cypress — kiến trúc" id="cypress-architecture">
        <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1010" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Cypress — chạy ở đâu và điều khiển app bằng cách nào" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="22" width="1300" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="sub" value="Hai tiến trình, và mã test nằm BÊN TRONG trình duyệt chứ không đứng ngoài điều khiển vào. Đó là khác biệt gốc so với Selenium / WebDriver." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1600" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="pnode" value="Tiến trình Node — Cypress server" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="50" y="110" width="640" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="runner" value="&lt;b&gt;Cypress runner&lt;/b&gt;&lt;br&gt;Đọc cypress.config.ts, gom danh sách spec, mở trình duyệt và điều phối vòng chạy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="165" width="580" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="proxy" value="&lt;b&gt;Proxy server  ★ trái tim của Cypress&lt;/b&gt;&lt;br&gt;MỌI request của trình duyệt đi qua đây.&lt;br&gt;• Chèn mã của Cypress vào HTML trả về — nhờ vậy nó điều khiển được trang.&lt;br&gt;• Đây mới là nơi cy.intercept thật sự chặn, sửa và theo dõi request — không phải trong trang." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="265" width="580" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="nodeev" value="&lt;b&gt;setupNodeEvents  (plugins)&lt;/b&gt;&lt;br&gt;Cửa DUY NHẤT để chạy code Node. Mã test nằm trong trình duyệt nên không có fs, không có socket.&lt;br&gt;Cần đọc file, gọi DB, sinh dữ liệu → phải đi qua cy.task." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="430" width="580" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="cdp" value="&lt;b&gt;Điều khiển trình duyệt qua CDP&lt;/b&gt;&lt;br&gt;Cookie, viewport, download, chuyển tab — những thứ JS trong trang không tự làm được." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="80" y="565" width="580" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="pbrw" value="Trình duyệt do Cypress mở và điều khiển" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="730" y="110" width="640" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="rui" value="Trang Cypress Runner UI — Command Log · danh sách spec · snapshot time-travel" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=11;fontStyle=1;fontColor=#3a5a86;" parent="1" vertex="1">
                    <mxGeometry x="760" y="165" width="580" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="aut" value="&lt;b&gt;&amp;lt;iframe&amp;gt;  AUT — ứng dụng đang test&lt;/b&gt;&lt;br&gt;Tải từ baseUrl. Chạy y như khi người dùng thật mở, không có bản dựng riêng cho test." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="790" y="235" width="520" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="spec" value="&lt;b&gt;Mã test — spec *.cy.ts + support / commands&lt;/b&gt;&lt;br&gt;Được đóng gói rồi nạp vào CHÍNH trang runner này, không phải chạy ở Node." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="790" y="365" width="520" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="loop" value="&lt;b&gt;Cả hai dùng chung MỘT event loop&lt;/b&gt;&lt;br&gt;Lệnh cy.get / cy.click thao tác thẳng vào DOM của iframe — không có round-trip qua mạng như WebDriver." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="790" y="495" width="520" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="web" value="&lt;b&gt;Web server phục vụ app&lt;/b&gt;&lt;br&gt;baseUrl — dev server hoặc bản build tĩnh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="265" width="310" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="api" value="&lt;b&gt;API backend&lt;/b&gt;&lt;br&gt;Thật hoặc giả, tuỳ bạn có stub bằng cy.intercept hay không" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1420" y="390" width="310" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="k1" value="&lt;b&gt;Vì sao nhanh hơn WebDriver&lt;/b&gt;&lt;br&gt;Không có giao thức trung gian. Lệnh test và code app chạy trong cùng một luồng JS, nên Cypress đọc được thẳng biến, DOM và cả network của app." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="50" y="740" width="400" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="k2" value="&lt;b&gt;Vì sao vướng cross-origin&lt;/b&gt;&lt;br&gt;AUT nằm trong iframe của trang runner ⇒ hai bên phải same-origin. Điều hướng sang origin khác là mất quyền truy cập. Đó là gốc của cy.origin(), chromeWebSecurity: false và injectDocumentDomain." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="470" y="740" width="400" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="k3" value="&lt;b&gt;Vì sao cy.intercept mạnh&lt;/b&gt;&lt;br&gt;Nó nằm ở proxy phía Node, không phải trong trang. Nên chặn được request từ trước khi trang kịp phát, sửa được header, và theo dõi được cả thứ app gọi ngầm." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="890" y="740" width="400" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="k4" value="&lt;b&gt;Vì sao cần cy.task&lt;/b&gt;&lt;br&gt;Mã test sống trong trình duyệt — không có fs, không có DB driver. Mọi việc chạm hệ thống phải đẩy sang Node qua setupNodeEvents." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1310" y="740" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="mở và điều khiển (CDP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#666666;" parent="1" source="runner" target="rui" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="mọi request đi qua proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#666666;" parent="1" source="aut" target="proxy" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="lấy HTML và asset" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#666666;" parent="1" source="proxy" target="web" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="gọi API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#666666;" parent="1" source="proxy" target="api" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="HTML đã được chèn mã Cypress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#666666;dashed=1;" parent="1" source="proxy" target="aut" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="thao tác thẳng vào DOM — không qua mạng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#666666;" parent="1" source="spec" target="aut" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="cy.task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#666666;dashed=1;" parent="1" source="spec" target="nodeev" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
