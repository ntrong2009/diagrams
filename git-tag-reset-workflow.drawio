                <mxCell id="t020" value="client-v0.2.0&#xa;✗ XOÁ ở bước ①" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="100" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="t147" value="client-v0.1.147&#xa;① tạo tay ở bước ②" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="100" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="t148" value="client-v0.1.148&#xa;do action tạo ở bước ⑤" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="100" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="tl_t146" value="" style="endArrow=none;html=1;strokeColor=#999999;dashed=1;" parent="1" source="t146" target="c1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tl_t020" value="" style="endArrow=none;html=1;strokeColor=#999999;dashed=1;" parent="1" source="t020" target="c3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tl_t147" value="" style="endArrow=none;html=1;strokeColor=#999999;dashed=1;" parent="1" source="t147" target="cm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="tl_t148" value="" style="endArrow=none;html=1;strokeColor=#999999;dashed=1;" parent="1" source="t148" target="ch" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="rng_no" value="Các commit feat cũ nằm NGOÀI range quét&#xa;⇒ action không thấy chúng ⇒ không bump minor" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;dashed=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="330" width="650" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="rng_ok" value="Range action quét: client-v0.1.147..HEAD&#xa;⇒ chỉ thấy fix + docs ⇒ patch bump" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="740" y="330" width="690" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="s1" value="① Xoá tag sai  (Developer)&#xa;&#xa;git push origin :refs/tags/client-v0.2.0&#xa;git tag -d client-v0.2.0&#xa;&#xa;Sau khi xoá, tag semver cao nhất trở lại là&#xa;client-v0.1.146." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="60" y="440" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="s2" value="② Ghim mốc thủ công  (Developer)&#xa;&#xa;git tag -a client-v0.1.147 -m &quot;Reset to standard milestone&quot;&#xa;git push origin client-v0.1.147&#xa;&#xa;Tag trỏ vào đúng commit mốc đã chọn." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="430" y="440" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="s3" value="③ Tạo Pull Request mới  (Developer)&#xa;&#xa;commit &quot;fix: fix UI&quot;&#xa;commit &quot;docs: update readme&quot;&#xa;git push &amp; open PR targeting main&#xa;&#xa;⚠ Commit KHÔNG được chứa #major / #minor,&#xa;nếu không sẽ phá mốc hiện tại." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="800" y="440" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="s4" value="④ Action truy vết lịch sử  (github-tag-action)&#xa;&#xa;Trigger khi push/merge vào main&#xa;Find latest tag → client-v0.1.147&#xa;Scan commits in range client-v0.1.147..HEAD&#xa;&#xa;Chỉ thấy fix + docs; commit feat cũ bị bỏ qua&#xa;vì nằm TRƯỚC tag mốc." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="440" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="s5" value="⑤ Bump version  (github-tag-action)&#xa;&#xa;Quyết định: patch release&#xa;Tạo tag client-v0.1.148&#xa;&#xa;Không phải 0.2.0, cũng không quay lại 0.1.147." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1540" y="440" width="340" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="why" value="Vì sao bước ② bắt buộc phải làm tay?&#xa;Nếu chỉ xoá client-v0.2.0 rồi để action tự bump, nó sẽ lấy mốc client-v0.1.146 và quét cả các commit feat cũ trong range client-v0.1.146..HEAD ⇒ ra minor bump (0.2.0) chứ không phải patch. Tag client-v0.1.147 đặt tay chính là con dao cắt range, để các commit feat đó nằm ngoài vùng quét." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="660" width="1150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="outcome" value="Kết quả&#xa;Version chạy tiếp tuần tự từ mốc đặt tay: client-v0.1.147 → client-v0.1.148." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;verticalAlign=top;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1250" y="660" width="570" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=10;" parent="1" source="s1" target="t020" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=10;" parent="1" source="s2" target="t147" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#666666;fontSize=10;" parent="1" source="s3" target="c5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
