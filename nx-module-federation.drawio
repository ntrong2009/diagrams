                <mxCell id="rt-legend" value="Legend&#xa;Blue = HOST (gridsz-client @ 4200) — owns shell, routes, and the active Angular runtime when winning the scope.&#xa;Green = REMOTE (gridsz-module-ac @ 4201) — exposed modules + a container that participates in the scope.&#xa;Yellow = build tooling / shared runtime data.&#xa;Gray = artifacts / config files." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;align=left;spacing=10;fontSize=11;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1030" width="1580" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="mlx6rZ2SGow3onH0DaEJ-1" value="module-federation.config.ts (the source of truth)&#xa;&#xa;HOST:&#xa;{&#xa;  name: &#39;gridsz-client&#39;,&#xa;  remotes: [],            // resolved at runtime via registerRemotes&#xa;  shared: (lib) =&gt; ({ singleton, strictVersion, ... }),&#xa;}&#xa;&#xa;REMOTE:&#xa;{&#xa;  name: &#39;gridsz-module-ac&#39;,&#xa;  exposes: {&#xa;    &#39;./AcModule&#39;:&#xa;      &#39;apps/gridsz-module-ac/src/app/ac-remote-entry/entry.routes.ts&#39;,&#xa;    &#39;./AddressConnectionComponent&#39;: ...,&#xa;  },&#xa;  shared: (lib) =&gt; ({ singleton, strictVersion, ... }),&#xa;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;align=left;spacing=10;fontFamily=monospace;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="130" width="620" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="mlx6rZ2SGow3onH0DaEJ-2" value="HOST output (dist/apps/gridsz-client)&#xa;• main.js (entry, MF auto-init code)&#xa;• vendor.js, polyfills.js&#xa;• remoteEntry.mjs (host as container)&#xa;• mf-manifest.json (declares shares/exposes)&#xa;• async chunks for shared deps:&#xa;    angular_core_..., angular_common_...,&#xa;    rxjs_..., etc.&#xa;• assets/module-federation.manifest.json&#xa;    (maps remote name → entry URL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="660" y="130" width="320" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="mlx6rZ2SGow3onH0DaEJ-3" value="REMOTE output (dist/apps/gridsz-module-ac)&#xa;• remoteEntry.mjs (container with init/get)&#xa;• mf-manifest.json&#xa;• exposed module chunks (AcModule, ...)&#xa;• shared dep chunks (Angular, rxjs, ...)&#xa;Served at http://localhost:4201/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="660" y="310" width="320" height="140" as="geometry"/>
