                <mxCell id="remote" value="REMOTE: gridsz-module-ac (http://localhost:4201)&lt;br&gt;&lt;br&gt;module-federation.config.ts&lt;br&gt;• exposes:&lt;br&gt;    &#39;./AcModule&#39;,&#39;./ADMModule&#39;,&#39;./ACEngineBoostModule&#39;,&lt;br&gt;    &#39;./AddressConnectionComponent&#39;,&lt;br&gt;    &#39;./DialogCreatePolygonComponent&#39;&lt;br&gt;• shared: SAME set as host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
