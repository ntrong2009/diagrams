                </mxCell>
                <mxCell id="host" value="HOST: gridsz-client (http://localhost:4200)&lt;br&gt;&lt;br&gt;module-federation.config.ts&lt;br&gt;• name: &#39;gridsz-client&#39;&lt;br&gt;• remotes: [] (registered at runtime)&lt;br&gt;• shared: @angular/*, rxjs, zone.js,&lt;br&gt;  @ngrx/*, @angular/cdk, material, moment, leaflet, ..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;" parent="1" vertex="1">
