                <mxCell id="hdr_build" value="Build-time&#xa;(CI/CD)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;fontColor=#4f7a34;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="150" width="180" height="288" as="geometry"/>
