                </mxCell>
                <mxCell id="sub" value="Mỗi hộp là một kỹ thuật, kèm trạng thái thật trong repo. Số liệu đếm từ project.json, package.json và mã nguồn apps/ + libs/." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" parent="1" vertex="1">
