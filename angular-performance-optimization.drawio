                </mxCell>
                <mxCell id="build_0" value="&lt;b&gt;AOT + production optimization&lt;/b&gt;&lt;br&gt;optimization: scripts, styles.minify, fonts đều bật" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="168" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_1" value="&lt;b&gt;outputHashing: all&lt;/b&gt;&lt;br&gt;hash nội dung vào tên file ⇒ cache vĩnh viễn, đổi file là bust" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="546" y="168" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_2" value="&lt;b&gt;Bundle budgets&lt;/b&gt;&lt;br&gt;initial 1mb/2mb · anyScript 500kb/2mb · componentStyle 50/100kb" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="854" y="168" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_3" value="&lt;b&gt;Code splitting&lt;/b&gt;&lt;br&gt;349 chỗ loadComponent ⇒ mỗi route một chunk riêng" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="168" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_4" value="&lt;b&gt;Module Federation&lt;/b&gt;&lt;br&gt;3 remote thành bundle độc lập, host không gánh" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="168" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_5" value="&lt;b&gt;moment-locales-webpack-plugin&lt;/b&gt;&lt;br&gt;cắt locale không dùng khỏi bundle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="258" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_6" value="&lt;b&gt;gzipper&lt;/b&gt;&lt;br&gt;nén dist trước khi đưa lên nginx" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="546" y="258" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_7" value="&lt;b&gt;esbuild-visualizer · madge&lt;/b&gt;&lt;br&gt;soi thành phần bundle và đồ thị import (chạy tay)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="854" y="258" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_8" value="&lt;b&gt;inlineCritical đang TẮT&lt;/b&gt;&lt;br&gt;optimization.styles.inlineCritical = false ở cả client và admin, trong khi mặc định của Angular là true. CSS above-the-fold không được inline ⇒ render bị chặn thêm một vòng tải CSS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="258" width="598" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="build_9" value="&lt;b&gt;Vẫn dùng webpack-browser&lt;/b&gt;&lt;br&gt;Executor là @nx/angular:webpack-browser, chưa chuyển sang application builder (esbuild/Vite). Build và serve chậm hơn đáng kể. Vướng: Module Federation hiện gắn với webpack." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="348" width="906" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_net" value="Mạng &amp; phân phối" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;fontColor=#3a5a86;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="438" width="180" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="lane_net" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="220" y="438" width="1558" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="net_0" value="&lt;b&gt;CDN edge&lt;/b&gt;&lt;br&gt;Cloudflare / GCP CDN phục vụ file tĩnh" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="456" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="net_1" value="&lt;b&gt;Gzip / Brotli&lt;/b&gt;&lt;br&gt;qua gzipper + CDN" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="546" y="456" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="net_2" value="&lt;b&gt;Cache-Control + ETag&lt;/b&gt;&lt;br&gt;file có hash ⇒ immutable, cache 1 năm" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="854" y="456" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="net_3" value="&lt;b&gt;Redis / API cache (BFF)&lt;/b&gt;&lt;br&gt;tầng dữ liệu phía server — xem angular-api-cache-layers" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="456" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="net_4" value="&lt;b&gt;preconnect / dns-prefetch&lt;/b&gt;&lt;br&gt;index.html mới chỉ có 3 rel=preload, chưa có preconnect tới origin API và CDN — thêm là bớt được một vòng DNS+TLS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="238" y="546" width="598" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="net_5" value="&lt;b&gt;HTTP/2 · HTTP/3 · TLS 1.3&lt;/b&gt;&lt;br&gt;do nginx/CDN quyết định, không thấy trong repo — nên xác nhận đã bật" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="854" y="546" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="net_6" value="&lt;b&gt;103 Early Hints&lt;/b&gt;&lt;br&gt;đẩy preload sớm trước khi HTML sẵn sàng" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="546" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_first" value="Tải trang lần đầu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;fontColor=#7f6000;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="636" width="180" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="lane_first" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;" parent="1" vertex="1">
                    <mxGeometry x="220" y="636" width="1558" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="first_0" value="&lt;b&gt;Lazy route&lt;/b&gt;&lt;br&gt;349 chỗ loadComponent — chỉ tải route đang vào" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="654" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="first_1" value="&lt;b&gt;rel=preload&lt;/b&gt;&lt;br&gt;3 khai báo trong index.html của gridsz-client" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="546" y="654" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="first_2" value="&lt;b&gt;NgOptimizedImage&lt;/b&gt;&lt;br&gt;28 chỗ dùng — srcset, priority, lazy dưới fold" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="854" y="654" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="first_3" value="&lt;b&gt;Không có SSR / SSG&lt;/b&gt;&lt;br&gt;@angular/ssr và @angular/platform-server đều KHÔNG được cài. Không prerender, không hydration ⇒ first paint phụ thuộc hoàn toàn vào việc tải và chạy JS." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="654" width="598" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="first_4" value="&lt;b&gt;Service worker chưa chạy&lt;/b&gt;&lt;br&gt;gridsz-admin có ngsw-config.json và bật serviceWorker khi build, nhưng không tìm thấy provideServiceWorker / ServiceWorkerModule.register ở đâu ⇒ SW được sinh ra nhưng không đăng ký. gridsz-client thì không cấu hình gì." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="744" width="906" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="first_5" value="&lt;b&gt;Preloading strategy&lt;/b&gt;&lt;br&gt;PreloadAllModules / quicklink: 0 chỗ dùng — nạp ngầm route kế tiếp lúc rảnh" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="744" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="first_6" value="&lt;b&gt;@defer&lt;/b&gt;&lt;br&gt;mới dùng đúng 1 chỗ — hoãn khối dưới màn hình tới khi viewport/idle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="744" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="first_7" value="&lt;b&gt;Chiến lược font&lt;/b&gt;&lt;br&gt;font-display: swap, subset, self-host, variable font — chưa rà trong repo" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="238" y="834" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_rt" value="Angular runtime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;fontColor=#6a4a8a;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="924" width="180" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="lane_rt" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;" parent="1" vertex="1">
                    <mxGeometry x="220" y="924" width="1558" height="288" as="geometry"/>
                </mxCell>
                <mxCell id="rt_0" value="&lt;b&gt;OnPush&lt;/b&gt;&lt;br&gt;346 component đặt ChangeDetectionStrategy.OnPush" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="942" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_1" value="&lt;b&gt;Signals&lt;/b&gt;&lt;br&gt;429 signal() · 443 computed() — reactivity hạt nhỏ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="546" y="942" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_2" value="&lt;b&gt;takeUntilDestroyed&lt;/b&gt;&lt;br&gt;825 chỗ — dọn subscription, tránh rò rỉ" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="854" y="942" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_3" value="&lt;b&gt;trackBy / @for track&lt;/b&gt;&lt;br&gt;112 chỗ — DOM diff thông minh khi đổi danh sách" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="942" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_4" value="&lt;b&gt;runOutsideAngular&lt;/b&gt;&lt;br&gt;12 chỗ — đẩy việc nặng ra ngoài Zone" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1470" y="942" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_5" value="&lt;b&gt;shareReplay&lt;/b&gt;&lt;br&gt;8 chỗ — chia sẻ kết quả stream, tránh gọi lại" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="1032" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_6" value="&lt;b&gt;HTTP Interceptor cache&lt;/b&gt;&lt;br&gt;cache payload API trong bộ nhớ app" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="546" y="1032" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_7" value="&lt;b&gt;CDK virtual scroll&lt;/b&gt;&lt;br&gt;mới 2 chỗ — nên soát lại các bảng/danh sách dài còn render hết" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="854" y="1032" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_8" value="&lt;b&gt;Web Worker&lt;/b&gt;&lt;br&gt;mới 1 chỗ — đẩy tính toán nặng khỏi main thread (INP)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="1032" width="290" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="rt_9" value="&lt;b&gt;Chưa zoneless&lt;/b&gt;&lt;br&gt;zone.js 0.16.3 vẫn nằm trong bundle, 0 chỗ provideZonelessChangeDetection. Angular 21 đã hỗ trợ; signals đã dùng rất nhiều (429/443) nên phần lớn điều kiện đã sẵn sàng." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="238" y="1122" width="598" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="hdr_meas" value="Đo lường" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;fontColor=#666666;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1212" width="180" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="lane_meas" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;" parent="1" vertex="1">
                    <mxGeometry x="220" y="1212" width="1558" height="198" as="geometry"/>
                </mxCell>
                <mxCell id="meas_0" value="&lt;b&gt;SonarQube&lt;/b&gt;&lt;br&gt;đo chất lượng và bug tĩnh — KHÔNG đo hiệu năng" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
