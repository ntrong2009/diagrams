                <mxCell id="fd_sub" value="Khung về &lt;b&gt;kỹ năng người dùng&lt;/b&gt; — không phải cơ chế của Claude Code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6b7280;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1801" width="900" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="fd_lblfb" value="Trình tự thường gặp khi làm việc — kết quả đánh giá dẫn tới lần giao việc kế tiếp" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;align=center;fontSize=11;fontColor=#868e96;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="1817" width="640" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d1" value="&lt;b&gt;D1 · Delegation&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Quyết định có / khi nào / cách nào giao việc cho AI&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Trong sơ đồ trên:&lt;/b&gt; chọn surface (CLI · IDE · web — quyết định luôn việc Tầng 2 chạy ở máy hay trên VM Anthropic) ·&lt;br&gt;chọn model · tự sửa hay để agent sửa · có tách Subagents không&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#d0ebff;strokeColor=#1971c2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1865" width="760" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d2" value="&lt;b&gt;D2 · Description&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Diễn đạt mục tiêu để AI làm đúng&lt;/i&gt;&lt;br&gt;&lt;b&gt;Prompting nằm ở đây&lt;/b&gt; — và chỉ là một phần của D này&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Trong sơ đồ trên:&lt;/b&gt; Your prompt (nhất thời) ·&lt;br&gt;CLAUDE.md · rules/ · skills/ · commands/ = Description được làm bền: viết 1 lần, dùng nhiều lượt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#d3f9d8;strokeColor=#2f9e44;" parent="1" vertex="1">
                    <mxGeometry x="840" y="1865" width="760" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d3" value="&lt;b&gt;D3 · Discernment&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;Đánh giá chất lượng, độ đúng, thiên lệch của output&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Trong sơ đồ trên:&lt;/b&gt; bước Verify results trong Agentic Loop · đọc diff trước khi accept ·&lt;br&gt;chạy test / lint · không tin báo cáo của agent mà không kiểm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#fff3bf;strokeColor=#e8a33d;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="1865" width="760" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="fd_d4" value="&lt;b&gt;D4 · Diligence&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size: 11px;&quot;&gt;— áp dụng cho cả ba bước trên, không phải một bước riêng&lt;/font&gt;&lt;br&gt;&lt;i&gt;Nhận trách nhiệm về việc mình dùng AI và cách dùng — gồm governance, đạo đức, an toàn&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;Đã cơ chế hoá trong sơ đồ trên:&lt;/b&gt;&amp;nbsp; Permission gate (allow / ask / deny) · Hooks · settings.json commit cho cả nhóm · Enterprise managed policy ★&lt;br&gt;&lt;b&gt;Không cơ chế hoá được:&lt;/b&gt;&amp;nbsp; minh bạch chỗ nào AI viết · chịu trách nhiệm khi merge · biết khi nào nên dừng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;spacingRight=12;fontSize=13;fontColor=#1f2937;fillColor=#e5dbff;strokeColor=#7048e8;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="2105" width="2360" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="fd_note" value="&lt;b&gt;Về khung 4D&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;— Tác giả: Prof Rick Dakan (Ringling College of Art and Design) &amp;amp; Prof Joseph Feller (University College Cork); dùng trong khoá AI Fluency của Anthropic.&lt;br&gt;— Nguồn: aifluencyframework.org · anthropic.skilljar.com/ai-fluency-framework-foundations&lt;br&gt;&lt;br&gt;— Khung gốc mô tả bốn D là &lt;b&gt;bốn năng lực phụ thuộc lẫn nhau&lt;/b&gt;, không quy định thứ tự bắt buộc. Mũi tên trình tự và vòng lặp ở đây là cách diễn giải để vẽ, không phải phát biểu của khung.&lt;br&gt;&lt;br&gt;— Màu mỗi ô khớp màu thành phần tương ứng ở phần kiến trúc phía trên: D4 tím = Permission gate / settings.json, D2 xanh lá = CLAUDE.md.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8f9fa;strokeColor=#adb5bd;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=13;fontColor=#495057;" parent="1" vertex="1">
