                            <mxPoint x="1250" y="645"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e5" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4f7a34;" parent="1" source="gate" target="s5a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
