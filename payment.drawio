                            <mxPoint x="1770" y="730"/>
                            <mxPoint x="1770" y="730"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e9" value="webhook payment.authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#7f6000;fontColor=#7f6000;fontStyle=1;" parent="1" source="s7" target="s8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="s8" target="s9" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="life_t" value="Sau khi authorize — vòng đời của khoản tiền (tính bằng ngày, không phải giây)" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="975" width="1200" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="st_auth" value="Authorized&#xa;tiền bị GIỮ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="620" y="1010" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="st_capt" value="Captured&#xa;đã trừ tiền" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="990" y="1010" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="st_settle" value="Settled&#xa;tiền về, trừ phí (T+n)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="1010" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="st_void" value="Voided&#xa;huỷ trước capture" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="250" y="1110" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="st_exp" value="Expired&#xa;hold tự rơi (~7 ngày)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="435" y="1200" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="st_refund" value="Refunded&#xa;(toàn phần / một phần)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="990" y="1110" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="st_disp" value="Disputed&#xa;khách mở tranh chấp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="1110" width="170" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="st_win" value="Thắng — giữ tiền" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="1210" width="170" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="st_lose" value="Chargeback&#xa;bị trừ tiền + phí" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1155" y="1210" width="190" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="note_life" value="&lt;b&gt;Ai khởi động cái gì&lt;/b&gt;&lt;br&gt;• Void / Refund: BẠN chủ động gọi API. Void chỉ dùng được khi chưa capture.&lt;br&gt;• Expired: không ai gọi cả — hết hạn authorization thì hold tự rơi, đơn hàng coi như hỏng.&lt;br&gt;• Disputed / Chargeback: KHÁCH mở với ngân hàng phát hành, về hệ thống bạn dưới dạng webhook, không phải API call của bạn. Bạn có hạn nộp bằng chứng (thường 7–21 ngày); quá hạn là mặc định thua.&lt;br&gt;• Mọi lần đổi trạng thái phải ghi vào ledger để đối soát được với sao kê của PSP." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1600" y="1005" width="820" height="175" as="geometry"/>
                </mxCell>
                <mxCell id="l1" value="capture" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="st_auth" target="st_capt" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l2" value="T+n ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="st_capt" target="st_settle" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l3" value="void" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="st_auth" target="st_void" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l4" value="không capture" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="st_auth" target="st_exp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l5" value="refund" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="st_capt" target="st_refund" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l6" value="khách khiếu nại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;" parent="1" source="st_settle" target="st_disp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l7" value="nộp bằng chứng, thắng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#4f7a34;" parent="1" source="st_disp" target="st_win" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="l8" value="thua" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b85450;" parent="1" source="st_disp" target="st_lose" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
