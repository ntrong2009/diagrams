                <mxCell id="e6" value="không — luồng miễn SCA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=1;fontColor=#b85450;" parent="1" source="gate" target="s6" edge="1">
